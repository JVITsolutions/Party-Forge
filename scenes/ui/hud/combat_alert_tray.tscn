[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/hud/combat_alert_tray.gd" id="1_script"]
[ext_resource type="Theme" path="res://data/ui/living_forge/living_forge_theme.tres" id="2_theme"]

[node name="CombatAlertTray" type="CanvasLayer"]
process_mode = 3
visible = false
script = ExtResource("1_script")

[node name="Overlay" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme = ExtResource("2_theme")

[node name="Dimmer" type="ColorRect" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0.01, 0.015, 0.025, 0.72)

[node name="Frame" type="PanelContainer" parent="Overlay"]
layout_mode = 1
anchors_preset = 0
anchor_left = 1.0
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -640.0
offset_top = 32.0
offset_right = -32.0
offset_bottom = -32.0
grow_horizontal = 0
grow_vertical = 2
theme_type_variation = &"LivingForgePanel"

[node name="Layout" type="VBoxContainer" parent="Overlay/Frame"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Overlay/Frame/Layout"]
layout_mode = 2
theme_type_variation = &"LivingForgeSectionLabel"
text = "CURRENT COMBAT ALERTS"

[node name="Count" type="Label" parent="Overlay/Frame/Layout"]
layout_mode = 2
theme_type_variation = &"LivingForgeCaptionLabel"
text = "0 CURRENT ALERTS"

[node name="Scroll" type="ScrollContainer" parent="Overlay/Frame/Layout"]
layout_mode = 2
size_flags_vertical = 3
follow_focus = true
horizontal_scroll_mode = 0

[node name="Alerts" type="VBoxContainer" parent="Overlay/Frame/Layout/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Close" type="Button" parent="Overlay/Frame/Layout"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2
focus_mode = 2
theme_type_variation = &"LivingForgeSecondaryButton"
text = "CLOSE"
accessibility_name = "Close complete combat alert tray"
