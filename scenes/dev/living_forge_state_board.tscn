[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/dev/living_forge_state_board.gd" id="1_script"]

[node name="LivingForgeStateBoard" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
accessibility_description = "Living Forge reusable component state board."
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.031, 0.051, 0.071, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 32.0
offset_top = 16.0
offset_right = -32.0
offset_bottom = -16.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 8

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"LivingForgeDisplayLabel"
text = "THE LIVING FORGE - COMPONENT PROOF"

[node name="Variant" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
theme_type_variation = &"LivingForgeStatusChip"
text = "NORMAL CONTRAST"

[node name="Device" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
theme_type_variation = &"LivingForgeCaptionLabel"
text = "ACTIVE INPUT: KEYBOARD MOUSE"

[node name="Rule" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_type_variation = &"LivingForgeCaptionLabel"
text = "ICON + SHAPE + TEXT - 48 PX TARGET FLOOR - 8 PX GRID - PRESENTATION ONLY"

[node name="SeatRow" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Scroll" type="ScrollContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="States" type="GridContainer" parent="Margin/Layout/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 8
columns = 4

[node name="PromptRow" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Footer" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Consumed" type="Label" parent="Margin/Layout/Footer"]
layout_mode = 2
