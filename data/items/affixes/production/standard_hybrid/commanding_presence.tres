[resource]
script = ExtResource("1_affix")
id = &"commanding_presence"
display_name = "Commanding Presence"
affix_kind = "prefix"
base_weight = 150.0
modifier_family_ids = Array[StringName]([&"damage_increased", &"party_influence_flat"])
