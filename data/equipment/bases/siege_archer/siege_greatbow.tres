[gd_resource type="Resource" script_class="EquipmentBaseDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/equipment/equipment_base_definition.gd" id="1_base"]
[ext_resource type="Resource" path="res://data/presentation/equipment/siege_archer/siege_greatbow.tres" id="2_presentation"]
[ext_resource type="Resource" path="res://data/items/weapon_profiles/siege_greatbow.tres" id="3_profile"]

[resource]
script = ExtResource("1_base")
id = &"siege_greatbow"
display_name = "Siege Greatbow"
item_type_id = &"bow"
compatible_slot_ids = Array[StringName]([&"main_hand"])
weight_class_id = &"weapon"
required_all_tags = Array[StringName]([&"ranged", &"greatbow"])
generation_weight = 100.0
generation_tags = Array[StringName]([&"ranged"])
implicit_affix_ids = Array[StringName]([&"siege_greatbow_implicit"])
handedness_id = &"two_hand"
reserved_slot_ids = Array[StringName]([&"off_hand"])
compatible_offhand_item_types = Array[StringName]([&"quiver"])
weapon_family_id = &"greatbow"
weapon_damage_profile = ExtResource("3_profile")
implicit_family_id = &"siege_archer"
presentation = ExtResource("2_presentation")
